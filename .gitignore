# ============================================================
# Drifit Editor — .gitignore (raiz)
# Versiona CÓDIGO, CONFIG e DOCS. Nunca chaves nem mídia pesada.
# ============================================================

# --- Segredos (uma única fonte: /.env na raiz) ---
.env
.env.local
.env.*
!.env.exemplo

# --- Ambientes, cache e lixo de sistema ---
.venv/
venv/
__pycache__/
*.py[cod]
.cache/
.cache/huggingface/
.pytest_cache/
.mypy_cache/
.DS_Store
Thumbs.db

# --- Segredos e estado local do agente ---
.claude/settings.local.json

# --- Mídia de produção (pesada e regenerável) ---
# Áudio/vídeo nunca entram no repositório.
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.m4a
*.aac
*.flac

# --- Pastas inteiras de mídia/renders (independente da extensão) ---
EP-00/
projetos/EP-00/
arquivo/
projetos/*/episodios/*/brutos/
projetos/*/episodios/*/renders/
projetos/*/episodios/*/workspace/media/
projetos/*/episodios/*/workspace/midia/
projetos/*/episodios/*/workspace/renders/
projetos/*/episodios/*/workspace/snap/
projetos/*/episodios/*/workspace/snap_logos/
projetos/*/episodios/*/workspace/fonts/

# --- Estado do HyperFrames (gerado a cada render) ---
.hyperframes/
**/hyperframes-extract-cache-*/

# --- Dependências Node.js (mantidas no disco, nunca no Git) ---
node_modules/

# --- IDE local (apenas git.ignoreLimitWarning) ---
.vscode/

# --- Backups, logs e pacotes compactados locais ---
*.orig
*.tmp
*.bak
*.log
docs.zip

# --- Workspaces e rodadas experimentais geradas em episódios (seletivo) ---
projetos/*/episodios/*/workspace/
projetos/*/episodios/*/workspace_*/
projetos/*/episodios/*/fase5_*/

# --- Executáveis pesados (>100 MB, limite GitHub) da toolchain ---
tools/hyperframes/bin/windows-x64/ffmpeg.exe
tools/hyperframes/bin/windows-x64/ffprobe.exe

# --- Backups manuais específicos (preservados no disco) ---
experimentos/video-motion/PLANO_POC_VIDEO_MOTION.md.pre_*
projetos/dr-gestao/motion-system/CATALOGO_MOTIONS.md.bak_pre_fase5_4
projetos/dr-gestao/motion-system/_backup_pre_fase4b1/
